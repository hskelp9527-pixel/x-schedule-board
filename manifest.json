{
  "manifest_version": 3,
  "name": "X 发稿安排表",
  "version": "1.2.0",
  "description": "记录定时发稿时间，在 X 页面查看安排，并从 X 已加载的定时列表补录。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "打开 X 发稿安排表"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "identity.js",
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "identity.js",
        "model.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
